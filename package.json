{
  "name": "welcomer-discord-bot",
  "version": "2.0.0",
  "description": "Discord Welcome Bot — Welcomer style with Canvas, PM2, cloud deploy",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js",
    "24": "pm2 start ecosystem.config.cjs",
    "24:stop": "pm2 stop discord-welcome-bot",
    "24:restart": "pm2 restart discord-welcome-bot",
    "24:logs": "pm2 logs discord-welcome-bot",
    "24:status": "pm2 status",
    "postinstall": "node -e \"try{require('@napi-rs/canvas')}catch(e){console.warn('Canvas: install build tools if image generation fails')}\""
  },
  "keywords": ["discord", "welcome", "welcomer", "canvas", "pm2"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "discord.js": "^14.16.3",
    "pm2": "^5.4.3"
  }
}
